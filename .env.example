# ============================================
# Phone Accessories Studio - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# ---------- Supabase 配置 ----------
# Supabase 项目 URL
SUPABASE_URL=https://your-project.supabase.co
# Supabase 匿名密钥（前端使用）
SUPABASE_KEY=your-supabase-anon-key
# Supabase Service Role 密钥（后端使用，拥有管理员权限）
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------- Cloudflare R2 对象存储 ----------
# R2 S3 兼容 API 端点
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2 Access Key ID
R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2 存储桶名称
R2_BUCKET_NAME=your-r2-bucket-name
# R2 公共访问 URL（用于生成图片链接）
R2_PUBLIC_URL=https://your-public-url.r2.dev

# ---------- Gemini API 配置 ----------
# Gemini API 密钥（文本生成）
GEMINI_API_KEY=your-gemini-api-key
# 文本 API Key（可与 GEMINI_API_KEY 相同）
TEXT_API_KEY=your-text-api-key
# 文本 API Base URL（OpenAI 兼容接口）
TEXT_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# 文本生成模型
TEXT_MODEL=gemini-3.5-flash

# ---------- 图片生成配置 ----------
# 图片 API Key（可与 GEMINI_API_KEY 相同）
OPENAI_IMAGE_API_KEY=your-image-api-key
# 图片 API Base URL（OpenAI 兼容接口）
OPENAI_IMAGE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# 图片生成模型
IMAGE_MODEL=gemini-3.1-flash-image

# ---------- 后台管理 ----------
# 管理后台密码
ADMIN_PASSWORD=your-admin-password

# ---------- 妙手 ERP API ----------
# 妙手应用 App Key
MIAOSHOU_APP_KEY=your-miaoshou-app-key
# 妙手应用 App Secret
MIAOSHOU_APP_SECRET=your-miaoshou-app-secret
